# ============================================================================
# Lark / Feishu OAuth — replaces the old Google sign-in. Same credentials
# pattern as Hamlet; PromptLab uses its own Lark app, not Hamlet's.
# Get these from the Lark admin console under "App credentials".
# ============================================================================
LARK_APP_ID=
LARK_APP_SECRET=

# Optional — defaults to https://open.larkoffice.com. Override if you're
# on a different Lark region/tenant or pointing at the staging endpoint.
LARK_BASE_URL=

# Canonical origin used to build the OAuth callback URL. If unset it is
# derived from the X-Forwarded-Host / Host header, which Cloud Run sets
# correctly — set it explicitly when the service sits behind a custom
# domain or the inferred URL is wrong.
APP_URL=

# Optional — explicit callback URL override. Useful in development if you
# want the redirect to hit a non-default host (e.g. ngrok). Format:
# https://your-host/api/auth/lark/callback
LARK_REDIRECT_URI=

# 32+ byte random string used to sign the session cookie (HMAC-SHA256).
# Rotate to invalidate every active session.
SESSION_SECRET=

# Postgres connection string for the persistent app state.
DATABASE_URL=

# AES-256-GCM key for provider-API-key encryption at rest in Postgres.
# Falls back to SESSION_SECRET if unset, but the two should be separate
# in production.
ENCRYPTION_SECRET=

# Background removal for the sticker flow runs locally on CPU inside the
# container (tools/bg-server.py) — no API key, nothing leaves the host.
# Override only if the sidecar port clashes with something.
BG_SERVER_PORT=
